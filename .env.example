# Copy to .env.local for local development. Everything is optional locally:
# with nothing set, leads and quotes are written to .data/db.json and emails
# are printed to the terminal. On AWS these are set in the Amplify console.

# Public address of the site. Used for canonical URLs, the sitemap, and every
# link in an email (sign-in links, quote links), so it must be the address the
# site is actually served from. Before the domain is switched over, use the
# Amplify address.
SITE_URL=https://inkabba.com

# Where leads and quotes are kept: the InkAbba Google Sheet (see README).
# Locally, point at a config file outside the repo that names the sheet and
# this machine's Google OAuth files:
INKABBA_SHEET_CONFIG=~/.config/inkabba/sheet.json
# On AWS: the sheet ID, and the Secrets Manager secret that holds the OAuth
# client and refresh token (JSON: client_id, client_secret, refresh_token).
# The refresh token can open every sheet of the Google account that granted it.
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_SECRET_ID=inkabba/google-sheets-oauth

# Outputs of infra/template.yaml. LEADS_TABLE moves leads and quotes from the
# sheet to DynamoDB; leave it empty while the sheet is in use.
LEADS_TABLE=
UPLOADS_BUCKET=

# Region of the table, bucket and SES identity (Amplify reserves AWS_* names).
APP_AWS_REGION=

# Who may sign in to the owner area at /admin (comma-separated). In
# production nobody can sign in until this is set.
OWNER_EMAILS=

# Verified SES sender and where new-lead emails are delivered.
SES_FROM="InkAbba <requests@inkabba.com>"
LEADS_NOTIFY_TO=

# Optional. Owner's mobile in +1XXXXXXXXXX form: each new lead also sends a text.
# Needs a registered sending number in AWS End User Messaging (see README).
LEADS_NOTIFY_SMS=

# "true" also emails the customer a short acknowledgment.
SEND_ACK=false

# Optional. Shows Google reviews on the home page (Places API, max 5 reviews).
# Restrict the key to the Places API in the Google Cloud console.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# GA4 measurement ID (G-XXXXXXXXXX). Leave empty to load no analytics.
NEXT_PUBLIC_GA_ID=
